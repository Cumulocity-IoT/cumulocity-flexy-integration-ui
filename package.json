{
  "name": "hms-flexy-integration-plugin",
  "version": "2.2.0",
  "description": "Provides an interface to register HMS Flexy devices from Talk2M into Cumulocity.",
  "scripts": {
    "serve": "from-env ng serve -u %TENANT",
    "serve:flexy": "npm run serve -- --shell %APP",
    "build": "ng build",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "postbuild": "node -e \"require('fs').rename('dist/plugin.zip', 'dist/${npm_package_name}_${npm_package_version}.zip', function(err) { if (err) console.log(err); console.log('File successfully renamed!') })\""
  },
  "keywords": [
    "cumulocity",
    "cumulocity-iot",
    "hms-flexy",
    "talk2m",
    "device-registration"
  ],
  "author": "Cumulocity GmbH, @dirk-peter-c8y",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cumulocity-IoT/cumulocity-flexy-integration-ui.git"
  },
  "bugs": {
    "url": "https://github.com/Cumulocity-IoT/cumulocity-flexy-integration-ui/issues"
  },
  "homepage": "https://github.com/Cumulocity-IoT/cumulocity-flexy-integration-ui#readme",
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/cdk": "^18.2.10",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@c8y/bootstrap": "1021.6.0",
    "@c8y/client": "1021.6.0",
    "@c8y/ngx-components": "1021.6.0",
    "@c8y/style": "1021.6.0",
    "ngx-bootstrap": "18.0.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.12",
    "@angular-eslint/eslint-plugin-template": "^19.2.1",
    "@angular-eslint/template-parser": "^19.2.1",
    "@angular/cli": "^18.2.12",
    "@angular/compiler-cli": "^18.2.0",
    "@c8y/devkit": "1021.6.0",
    "@c8y/options": "1021.6.0",
    "@stylistic/eslint-plugin": "^4.2.0",
    "@types/jasmine": "~5.1.0",
    "@types/lodash": "^4.17.13",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "from-env": "^1.1.4",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "rimraf": "^5.0.10",
    "typescript": "~5.5.2"
  },
  "overrides": {
    "globals": "14.0.0"
  }
}
